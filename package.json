{
  "name": "wacleanenergy-org",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Washington Clean Energy Coalition website — Astro on Cloudflare Pages",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write \"src/**/*.{ts,astro,css}\"",
    "lint": "prettier --check \"src/**/*.{ts,astro,css}\" && astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deploy": "astro build && wrangler pages deploy dist/ --project-name wacleanenergy-org"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.2.0",
    "astro": "^5.6.1",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@vitest/coverage-v8": "^4.0.18",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "vitest": "^4.0.18",
    "wrangler": "^3.90.0"
  }
}
