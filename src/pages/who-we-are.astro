---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { Content } from "../content/pages/who-we-are.md";
import chairPhoto from "../assets/people/don-marsh.jpg";
---

<BaseLayout
  title="Who we are"
  description="About the Washington Clean Energy Coalition — an all-volunteer group of Washingtonians."
>
  <section class="mx-auto max-w-3xl px-6 py-14">
    <h1 class="text-3xl font-bold text-brand-dark">Who we are</h1>
    <!-- flow-root on the wrapper contains the floated figure so it
         can't overflow into the CTA below. -->
    <div class="post-body mt-4 flow-root">
      <figure
        class="mx-auto my-6 w-full max-w-[225px] sm:float-right sm:mx-0 sm:my-0 sm:mb-4 sm:ml-6"
      >
        <Image
          src={chairPhoto}
          alt="Don Marsh"
          width={225}
          densities={[1, 2]}
          class="w-full rounded-md"
        />
        <figcaption class="mt-2 text-center text-sm text-ink/70">
          Don Marsh, Chair
        </figcaption>
      </figure>
      <Content />
    </div>
    <div class="mt-10">
      <a
        href="/what-we-do"
        class="inline-block rounded-md bg-brand-dark px-5 py-2.5 font-medium text-white transition-colors hover:bg-brand"
        >What we do →</a
      >
    </div>
  </section>
</BaseLayout>
