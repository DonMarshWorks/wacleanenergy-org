---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAccomplishments } from "../lib/accomplishments";
import { formatMonth } from "../lib/format";

const items = await getAccomplishments();
---

<BaseLayout
  title="Accomplishments"
  description="What the Washington Clean Energy Coalition has achieved."
>
  <section class="mx-auto max-w-3xl px-6 py-14">
    <h1 class="text-3xl font-bold text-brand-dark">Accomplishments</h1>
    <p class="mt-4 leading-relaxed">
      A record of the coalition's submissions to regulators and other milestones
      in our advocacy work.
    </p>
    <ol class="mt-8 space-y-8">
      {
        items.map((item) => (
          <li>
            <p class="text-sm text-ink/70">
              <time datetime={item.data.date.toISOString()}>
                {formatMonth(item.data.date)}
              </time>
            </p>
            <h2 class="mt-1 text-xl font-semibold text-brand-dark">
              {item.data.title}
            </h2>
            <p class="mt-2 leading-relaxed">{item.data.description}</p>
            {item.data.link && (
              <a
                class="mt-2 inline-block text-sm font-medium text-brand hover:underline"
                href={item.data.link}
                target="_blank"
                rel="noopener noreferrer"
              >
                Read the filing →
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
