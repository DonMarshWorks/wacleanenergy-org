---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPartners } from "../lib/partners";

const partners = await getPartners();
---

<BaseLayout
  title="Coalition Partners"
  description="Organizations the Washington Clean Energy Coalition works alongside."
>
  <section class="mx-auto max-w-3xl px-6 py-14">
    <h1 class="text-3xl font-bold text-brand-dark">Coalition partners</h1>
    <p class="mt-4 leading-relaxed">
      We coordinate with organizations across Washington that share our goal of
      a clean, affordable, reliable energy future.
    </p>
    <ul class="mt-8 space-y-3">
      {
        partners.map((partner) => (
          <li class="border-b border-brand/15 pb-3">
            <a
              class="font-medium text-brand-dark hover:text-brand hover:underline"
              href={partner.data.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {partner.data.name}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
