---
import BaseLayout from "../layouts/BaseLayout.astro";
// Draft copy — pending coalition review. See docs/plans/content-migration.md Q3.
---

<BaseLayout
  title="Washington Clean Energy Coalition"
  description="An all-volunteer nonprofit accelerating Washington State's transition to clean, carbon-free energy."
>
  <section class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-4xl font-bold tracking-tight text-brand-dark sm:text-5xl">
      Let's get this transition right.
    </h1>
    <p class="mt-6 text-lg leading-relaxed">
      The Washington Clean Energy Coalition is an all-volunteer nonprofit
      working to move Washington State to carbon-free electricity by 2045. We
      engage directly with Puget Sound Energy and the Washington Utilities and
      Transportation Commission to push for a faster, fairer shift away from
      fossil fuels.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href="/what-we-do"
        class="rounded-md bg-brand-dark px-5 py-2.5 font-medium text-white transition-colors hover:bg-brand"
        >What we do</a
      >
      <a
        href="/contact"
        class="rounded-md border border-brand-dark px-5 py-2.5 font-medium text-brand-dark transition-colors hover:bg-brand-dark hover:text-white"
        >Get involved</a
      >
    </div>
  </section>

  <section class="border-t border-brand/15 bg-white/50">
    <div class="mx-auto max-w-3xl px-6 py-14">
      <h2 class="text-2xl font-semibold text-brand-dark">Why it matters</h2>
      <p class="mt-4 leading-relaxed">
        Washington's Clean Energy Transformation Act requires carbon-free
        electricity by 2045. Yet Puget Sound Energy — the state's largest
        utility — continues to plan for new natural gas capacity. We work to
        hold utilities to the law's intent: a grid powered by clean, affordable,
        reliable energy.
      </p>
      <a
        href="/accomplishments"
        class="mt-4 inline-block font-medium text-brand hover:underline"
        >See what we've accomplished →</a
      >
    </div>
  </section>
</BaseLayout>
