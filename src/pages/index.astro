---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeFeature from "../components/HomeFeature.astro";
import { Content } from "../content/pages/home.mdx";
---

<BaseLayout
  title="Washington Clean Energy Coalition"
  description="Washington volunteers engaging utilities, regulators, and legislators for clean energy that costs less, stays reliable, and eliminates pollution."
>
  <section class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-4xl font-bold tracking-tight text-brand-dark sm:text-5xl">
      Let's get this transition right.
    </h1>
    <p class="mt-4 text-lg italic text-ink/85">
      Washington volunteers engage utilities, regulators, and legislators to get
      clean energy right.
    </p>
    <div class="post-body mt-8">
      <Content />
    </div>
    <HomeFeature
      eyebrow="What we're working on"
      title="WCEC responds to PSE's 2027 Integrated System Plan"
      body="PSE's preliminary plan would make natural gas the single largest source of new electricity through 2050 — more than wind and solar combined. Our policy briefing lays out a better path: use the resources we already own, upgrade the grid we have today, and trim the gas system fairly."
      href="/news/2026-06-pse-2027-isp-response/"
      linkText="Read our response"
    />
    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href="/what-we-do"
        class="rounded-md bg-brand-dark px-5 py-2.5 font-medium text-white transition-colors hover:bg-brand"
        >What we do</a
      >
      <a
        href="/who-we-are"
        class="rounded-md border border-brand-dark px-5 py-2.5 font-medium text-brand-dark transition-colors hover:bg-brand-dark hover:text-white"
        >Who we are</a
      >
      <a
        href="/contact"
        class="rounded-md border border-brand-dark px-5 py-2.5 font-medium text-brand-dark transition-colors hover:bg-brand-dark hover:text-white"
        >Get involved</a
      >
    </div>
  </section>
</BaseLayout>
