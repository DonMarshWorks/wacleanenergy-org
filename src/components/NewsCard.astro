---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/format";
import Outcome from "./Outcome.astro";

interface Props {
  post: CollectionEntry<"news">;
}

const { post } = Astro.props;
const href = `/news/${post.id}/`;
---

<article class="border-b border-brand/15 py-6 last:border-b-0">
  <p class="text-sm text-ink/85">
    <time datetime={post.data.pubDate.toISOString()}
      >{formatDate(post.data.pubDate)}</time
    >
  </p>
  <h2 class="mt-1 text-xl font-semibold text-brand-dark">
    <a class="hover:text-brand" href={href}>{post.data.title}</a>
  </h2>
  <p class="mt-2">{post.data.description}</p>
  {post.data.outcome && <Outcome outcome={post.data.outcome} variant="card" />}
  <a
    class="mt-2 inline-block text-sm font-medium text-brand hover:underline"
    href={href}
    aria-label={`Read more: ${post.data.title}`}>Read more →</a
  >
</article>
