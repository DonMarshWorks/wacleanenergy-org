---
interface Props {
  eyebrow: string;
  title: string;
  body: string;
  href: string;
  linkText: string;
}

const { eyebrow, title, body, href, linkText } = Astro.props;
---

<aside
  class="mt-10 rounded-lg border border-brand/40 bg-white p-6 sm:p-7"
  aria-labelledby="home-feature-title"
>
  <p class="text-xs font-semibold uppercase tracking-wider text-brand">
    {eyebrow}
  </p>
  <h2
    id="home-feature-title"
    class="mt-2 text-xl font-semibold text-brand-dark sm:text-2xl"
  >
    <a class="hover:text-brand" href={href}>{title}</a>
  </h2>
  <p class="mt-3 leading-relaxed text-ink">{body}</p>
  <a
    class="mt-4 inline-block text-sm font-medium text-brand hover:underline"
    href={href}
    aria-label={`${linkText}: ${title}`}
  >
    {linkText} →
  </a>
</aside>
