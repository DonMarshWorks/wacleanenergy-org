---
import { formatDate } from "../lib/format";

// Renders a news post's optional advocacy outcome. Two variants:
//   - "card" — a compact status badge + one-line summary for the index
//   - "full" — a bordered callout box with the complete text for the post
// The status drives a colour, label, and inline SVG icon (a 0 0 24 24
// stroke icon: check, cross, or a six-point asterisk).

interface Props {
  outcome: {
    status: "win" | "setback" | "mixed" | "pending";
    text: string;
    date?: Date;
  };
  variant: "card" | "full";
}

const { outcome, variant } = Astro.props;

const STATUS = {
  win: {
    label: "Win",
    color: "var(--color-success)",
    icon: "M20 6 9 17l-5-5",
  },
  setback: {
    label: "Setback",
    color: "var(--color-warn)",
    icon: "M18 6 6 18M6 6l12 12",
  },
  mixed: {
    label: "Mixed",
    color: "var(--color-ink)",
    icon: "M12 3v18M4.2 7.5l15.6 9M19.8 7.5l-15.6 9",
  },
  pending: {
    label: "Pending",
    color: "var(--color-pending)",
    icon: "M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18M12 7.5V12l3.5 2",
  },
} as const;

const s = STATUS[outcome.status];
---

{
  variant === "card" ? (
    <p class="mt-3 flex items-center gap-2 text-sm">
      <span
        class="inline-flex shrink-0 items-center gap-1 rounded-full px-2 py-0.5 text-xs font-semibold text-white"
        style={`background:${s.color}`}
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-3 w-3"
          aria-hidden="true"
        >
          <path d={s.icon} />
        </svg>
        {s.label}
      </span>
      <span class="min-w-0 truncate text-ink/85">{outcome.text}</span>
    </p>
  ) : (
    <aside
      class="mt-6 rounded-lg border border-l-4 border-brand/15 bg-white p-4"
      style={`border-left-color:${s.color}`}
    >
      <p
        class="flex items-center gap-2 font-semibold"
        style={`color:${s.color}`}
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <path d={s.icon} />
        </svg>
        Outcome: {s.label}
      </p>
      <p class="mt-2 leading-relaxed text-ink">{outcome.text}</p>
      {outcome.date && (
        <p class="mt-2 text-sm text-ink/85">
          <time datetime={outcome.date.toISOString()}>
            {formatDate(outcome.date)}
          </time>
        </p>
      )}
    </aside>
  )
}
